<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#00D4FF"
            android:background="@drawable/btn_social_neon"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/details_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/ivFavoriteDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_favorite_border"
            app:tint="#80FFFFFF"
            android:background="@drawable/btn_social_neon"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Content: Image Left + Info Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Image -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/image_container"
            android:gravity="center"
            android:layout_margin="16dp"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivComputer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery"/>

        </LinearLayout>

        <!-- Right: Info -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_glass_neon"
                android:layout_margin="16dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Brand"
                    android:textColor="#00D4FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Model"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#00E5FF"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1A00D4FF"
                    android:layout_marginBottom="12dp"/>

                <!-- Specs -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/processor" android:textColor="#99FFFFFF" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvProcessor" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Processor" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ram" android:textColor="#99FFFFFF" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvRam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="RAM" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/storage" android:textColor="#99FFFFFF" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvStorage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Storage" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/graphics" android:textColor="#99FFFFFF" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvGraphics" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Graphics" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A00D4FF" android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="13sp"
                    android:textColor="#A6FFFFFF"
                    android:layout_marginBottom="12dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A00D4FF" android:layout_marginBottom="12dp"/>

                <!-- Quantity -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnMinus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="-"
                        android:textSize="18sp"
                        android:textColor="#00D4FF"
                        android:background="@drawable/btn_social_neon"
                        android:stateListAnimator="@null"
                        android:padding="0dp"/>

                    <TextView
                        android:id="@+id/tvQuantity"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>

                    <Button
                        android:id="@+id/btnPlus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:textColor="#00D4FF"
                        android:background="@drawable/btn_social_neon"
                        android:stateListAnimator="@null"
                        android:padding="0dp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnAddToCart"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/add_to_cart"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_neon_gradient"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnBuyNow"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/buy_now"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#00D4FF"
                    android:background="@drawable/btn_social_neon"
                    android:stateListAnimator="@null"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>