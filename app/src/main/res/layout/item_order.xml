<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_glass_neon"
    android:layout_margin="8dp"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvOrderDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026-06-14"
            android:textColor="#00D4FF"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAID"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_neon_gradient"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

    </LinearLayout>

    <!-- Items -->
    <TextView
        android:id="@+id/tvOrderItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Items"
        android:textColor="#AAFFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A00D4FF"
        android:layout_marginBottom="8dp"/>

    <!-- Payment + Delivery -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvPaymentMethod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💳 Card"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvDeliveryMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦 Standard"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvOrderTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Tracking Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A00D4FF"
        android:layout_marginBottom="12dp"/>

    <!-- Tracking Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 Tracking"
        android:textColor="#00D4FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <!-- Tracking Steps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/step1Dot"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/btn_neon_gradient"
                android:gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Placed"
                android:textColor="#FFFFFF"
                android:textSize="9sp"/>

        </LinearLayout>

        <!-- Line 1 -->
        <View
            android:id="@+id/line1"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="0.5"
            android:layout_marginBottom="16dp"
            android:background="#1A00D4FF"/>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/step2Dot"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/btn_social_neon"
                android:gravity="center"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Process"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"/>

        </LinearLayout>

        <!-- Line 2 -->
        <View
            android:id="@+id/line2"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="0.5"
            android:layout_marginBottom="16dp"
            android:background="#1A00D4FF"/>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/step3Dot"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/btn_social_neon"
                android:gravity="center"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shipped"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"/>

        </LinearLayout>

        <!-- Line 3 -->
        <View
            android:id="@+id/line3"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="0.5"
            android:layout_marginBottom="16dp"
            android:background="#1A00D4FF"/>

        <!-- Step 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/step4Dot"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/btn_social_neon"
                android:gravity="center"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"/>

        </LinearLayout>

        <!-- Line 4 -->
        <View
            android:id="@+id/line4"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="0.5"
            android:layout_marginBottom="16dp"
            android:background="#1A00D4FF"/>

        <!-- Step 5 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/step5Dot"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/btn_social_neon"
                android:gravity="center"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Delivered Banner -->
    <TextView
        android:id="@+id/tvDelivered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ Package delivered!"
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/btn_social_neon"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>
        </LinearLayout>

